    "Settings": {
      "additionalProperties": false,
      "properties": {
        "db_path": {
          "default": "var/memory.sqlite3",
          "format": "path",
          "title": "Db Path",
          "type": "string"
        },
        "api_url": {
          "default": "http://127.0.0.1:8000",
          "title": "Api Url",
          "type": "string"
        },
        "model_name": {
          "default": "deepseek-flash",
          "title": "Model Name",
          "type": "string"
        },
        "model_base_url": {
          "const": "https://api.deepseek.com",
          "default": "https://api.deepseek.com",
          "title": "Model Base Url",
          "type": "string"
        },
        "model_timeout_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Model Timeout Seconds",
          "type": "number"
        },
        "model_retries": {
          "default": 2,
          "maximum": 10,
          "minimum": 0,
          "title": "Model Retries",
          "type": "integer"
        },
        "model_temperature": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Model Temperature",
          "type": "number"
        },
        "model_max_tokens": {
          "default": 8192,
          "exclusiveMinimum": 0,
          "title": "Model Max Tokens",
          "type": "integer"
        },
        "relation_max_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relation Max Tokens"
        },
        "thinking_enabled": {
          "const": false,
          "default": false,
          "title": "Thinking Enabled",
          "type": "boolean"
        },
        "extraction_thinking_effort": {
          "default": "disabled",
          "enum": [
            "disabled",
            "low",
            "high"
          ],
          "title": "Extraction Thinking Effort",
          "type": "string"
        },
        "relation_thinking_effort": {
          "default": "high",
          "enum": [
            "disabled",
            "low",
            "high"
          ],
          "title": "Relation Thinking Effort",
          "type": "string"
        },
        "query_analysis_thinking_effort": {
          "default": "disabled",
          "enum": [
            "disabled",
            "low",
            "high"
          ],
          "title": "Query Analysis Thinking Effort",
          "type": "string"
        },
        "resolution_thinking_effort": {
          "default": "low",
          "enum": [
            "disabled",
            "low",
            "high"
          ],
          "title": "Resolution Thinking Effort",
          "type": "string"
        },
        "answer_thinking_effort": {
          "default": "disabled",
          "enum": [
            "disabled",
            "low",
            "high"
          ],
          "title": "Answer Thinking Effort",
          "type": "string"
        },
        "embedding_model": {
          "const": "sentence-transformers/all-MiniLM-L6-v2",
          "default": "sentence-transformers/all-MiniLM-L6-v2",
          "title": "Embedding Model",
          "type": "string"
        },
        "embedding_revision": {
          "default": "c9745ed1d9f207416be6d2e6f8de32d1f16199bf",
          "pattern": "^[a-f0-9]{40}$",
          "title": "Embedding Revision",
          "type": "string"
        },
        "embedding_dimensions": {
          "const": 384,
          "default": 384,
          "title": "Embedding Dimensions",
          "type": "integer"
        },
        "embedding_local_files_only": {
          "default": true,
          "title": "Embedding Local Files Only",
          "type": "boolean"
        },
        "embedding_max_tokens": {
          "default": 256,
          "exclusiveMinimum": 0,
          "title": "Embedding Max Tokens",
          "type": "integer"
        },
        "fragment_turns": {
          "default": 20,
          "exclusiveMinimum": 0,
          "title": "Fragment Turns",
          "type": "integer"
        },
        "bm25_k": {
          "default": 20,
          "exclusiveMinimum": 0,
          "title": "Bm25 K",
          "type": "integer"
        },
        "dense_k": {
          "default": 20,
          "exclusiveMinimum": 0,
          "title": "Dense K",
          "type": "integer"
        },
        "initial_k": {
          "default": 20,
          "exclusiveMinimum": 0,
          "title": "Initial K",
          "type": "integer"
        },
        "rrf_constant": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Rrf Constant",
          "type": "integer"
        },
        "expansion_max_candidates": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Expansion Max Candidates",
          "type": "integer"
        },
        "expansion_depth": {
          "default": 1,
          "enum": [
            0,
            1
          ],
          "title": "Expansion Depth",
          "type": "integer"
        },
        "expansion_scan_limit": {
          "default": 200,
          "exclusiveMinimum": 0,
          "title": "Expansion Scan Limit",
          "type": "integer"
        },
        "relation_history_limit": {
          "default": 20,
          "exclusiveMinimum": 0,
          "title": "Relation History Limit",
          "type": "integer"
        },
        "relation_same_key_fraction": {
          "default": 0.8,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Relation Same Key Fraction",
          "type": "number"
        },
        "relation_fact_fraction": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Relation Fact Fraction",
          "type": "number"
        },
        "candidate_token_budget": {
          "default": 12000,
          "exclusiveMinimum": 0,
          "title": "Candidate Token Budget",
          "type": "integer"
        },
        "evidence_token_budget": {
          "default": 6000,
          "exclusiveMinimum": 0,
          "title": "Evidence Token Budget",
          "type": "integer"
        },
        "raw_max_hits": {
          "default": 3,
          "exclusiveMinimum": 0,
          "title": "Raw Max Hits",
          "type": "integer"
        },
        "raw_neighbor_turns": {
          "default": 1,
          "maximum": 3,
          "minimum": 0,
          "title": "Raw Neighbor Turns",
          "type": "integer"
        },
        "raw_max_turns": {
          "default": 9,
          "exclusiveMinimum": 0,
          "title": "Raw Max Turns",
          "type": "integer"
        },
        "raw_token_budget": {
          "default": 2000,
          "exclusiveMinimum": 0,
          "title": "Raw Token Budget",
          "type": "integer"
        },
        "resolution_input_budget": {
          "default": 24000,
          "exclusiveMinimum": 0,
          "title": "Resolution Input Budget",
          "type": "integer"
        }
      },
      "title": "Settings",
      "type": "object"
    },
