    "Memory": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "memory_type": {
          "enum": [
            "event",
            "state"
          ],
          "title": "Memory Type",
          "type": "string"
        },
        "statement_type": {
          "enum": [
            "fact",
            "plan",
            "intention",
            "uncertain"
          ],
          "title": "Statement Type",
          "type": "string"
        },
        "polarity": {
          "enum": [
            "positive",
            "negative"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "entity_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Entity Id",
          "type": "string"
        },
        "state_dimension": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "State Dimension",
          "type": "string"
        },
        "state_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State Value"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "time": {
          "$ref": "#/$defs/TemporalInfo"
        },
        "memory_id": {
          "title": "Memory Id",
          "type": "string"
        },
        "build_id": {
          "title": "Build Id",
          "type": "string"
        },
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "sample_id": {
          "title": "Sample Id",
          "type": "string"
        },
        "state_key": {
          "title": "State Key",
          "type": "string"
        },
        "session_times": {
          "items": {
            "type": "string"
          },
          "title": "Session Times",
          "type": "array"
        }
      },
      "required": [
        "content",
        "memory_type",
        "statement_type",
        "polarity",
        "entity_id",
        "state_dimension",
        "source_ids",
        "memory_id",
        "build_id",
        "dataset_id",
        "sample_id",
        "state_key",
        "session_times"
      ],
      "title": "Memory",
      "type": "object"
    },
